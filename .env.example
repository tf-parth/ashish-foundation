# Single Source of Truth for UPI Donations
# ------------------------------------------------------------
# The project previously contained conflicting IDs:
# - "8299052548m@pnb" (configured in donation code)
# - "ashishfoundation@upi" (labeled on old un-scannable mock image)
#
# Set the verified foundation UPI ID here:
NEXT_PUBLIC_UPI_ID=8299052548m@pnb

# Verified Recipient / Payee Name (displayed in UPI apps)
NEXT_PUBLIC_UPI_NAME="Ashish Foundation"

# Set to "true" after the account owner verifies receipt of a test payment
NEXT_PUBLIC_UPI_VERIFIED=true

# ============================================================
# Supabase Configuration
# ------------------------------------------------------------
# Found in your Supabase Project Settings -> API
# NEXT_PUBLIC_SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: anon / publishable public API key
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://vdevicolcnrebcykdaao.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TvkNMmHwPQ-ab8iG-qN5tA_Hd9_xrsl
# Server-only Service Role Key (OPTIONAL - only for elevated backend/admin tasks)
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client-side code
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

